# Copy to /etc/systemd/system/ and set User/paths (see README). Rebuilds ol_books.
[Unit]
Description=Seferehov: refresh local Open Library catalogue
After=network-online.target docker.service

[Service]
Type=oneshot
User=APP_USER
ExecStart=APP_DIR/deploy/ol-refresh.sh
Nice=19
IOSchedulingClass=idle
CPUQuota=1600%
