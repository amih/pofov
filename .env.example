# Server
PORT=3870
HOST=127.0.0.1
BASE_URL=http://localhost:5173
DATABASE_URL=postgres://pofov:pofov@127.0.0.1:5470/pofov
UPLOAD_DIR=./uploads
WEB_DIST=../web/dist
# Comma-separated emails that get admin (trust level 3) on first login
ADMIN_EMAILS=
# Clients with a build number lower than this get HTTP 426 and must update
MIN_CLIENT_BUILD=0
# Approved contributions after which a user's submissions auto-publish
TRUST_THRESHOLD=5
# SMTP for magic links. Empty SMTP_HOST = links are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=POFOV <noreply@example.com>
# Google sign-in (optional). The OAuth client must list
# BASE_URL/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
